# 依赖与构建产物
node_modules/

# 本地数据库与真实 Token（含个人游戏进度，禁止提交）
data/
.env
.env.local
.env.*.local
.mcp.json

# 原始美术素材（约 257MB，仅本地保留，Web 资产由 scripts/build-assets.py 生成到 assets/）
raw/

# SQLite 散落文件（MCD_DB 指向项目内其他位置的测试库）
*.db
*.db-wal
*.db-shm

# Python 缓存（资产生成脚本）
__pycache__/
*.py[cod]

# 编辑器目录
.vscode/
.idea/

# 系统文件
.DS_Store
Thumbs.db
*.log

# Playwright
.playwright-cli/

# 临时文件
.tmp-*
*.tmp
